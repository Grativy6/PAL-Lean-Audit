  "signatures": {
    "Experiments.SingleCutCorridor.filled_corridor_invariant": "Experiments.SingleCutCorridor.filled_corridor_invariant : ∀ (e c d : ℕ) (u : Finset ℕ),\n  u.Nonempty →\n    Experiments.SingleCutSpan.charge (Experiments.SingleCutSpan.serial e c u) =\n      Experiments.SingleCutSpan.charge (Experiments.SingleCutSpan.serial e d u)",
    "Experiments.SingleCutCorridor.corridor_permutation": "Experiments.SingleCutCorridor.corridor_permutation : ∀ (e c : ℕ) (p : Equiv.Perm (Fin (c + 1))),\n  Finset.image (fun i => e + 1 + ↑(p i)) Finset.univ = Finset.Icc (e + 1) (e + c + 1)",
    "Experiments.SingleCutCorridor.unit_admissible_iff": "Experiments.SingleCutCorridor.unit_admissible_iff : ∀ (e c : ℕ),\n  e ≤ 1 →\n    ∀ (u : Finset ℕ) (hu : u.Nonempty),\n      Experiments.SingleCutSpan.charge (Experiments.SingleCutSpan.serial e c u) ≤ 1 ↔ u.max' hu + 1 - u.card ≤ 1 - e",
    "Experiments.SingleCutCorridor.valid_unused_capacity": "Experiments.SingleCutCorridor.valid_unused_capacity : ∀ (e s : ℕ), e + s ≤ 1 → e + s + (1 - e - s) = 1",
    "Experiments.SingleCutCorridor.invalid_truncation_does_not_close": "Experiments.SingleCutCorridor.invalid_truncation_does_not_close : 1 + 1 + (1 - 1 - 1) ≠ 1",
    "Experiments.SingleCutCorridor.zero_slack_iff_exact_prefix": "Experiments.SingleCutCorridor.zero_slack_iff_exact_prefix : ∀ (u : Finset ℕ) (hu : u.Nonempty),\n  u.max' hu + 1 - u.card = 0 ↔ u = Finset.range (u.max' hu + 1)",
    "Experiments.SingleCutCorridor.one_slack_iff_prefix_bound": "Experiments.SingleCutCorridor.one_slack_iff_prefix_bound : ∀ (u : Finset ℕ) (hu : u.Nonempty),\n  u.max' hu + 1 - u.card ≤ 1 ↔ u ⊆ Finset.range (u.card + 1)",
    "Experiments.SingleCutCorridor.erased_interior_adds_one": "Experiments.SingleCutCorridor.erased_interior_adds_one : ∀ (s : Finset ℕ) (hs : s.Nonempty),\n  ∀ k ∈ s,\n    s.min' hs < k →\n      k < s.max' hs → Experiments.SingleCutSpan.charge (s.erase k) = Experiments.SingleCutSpan.charge s + 1",
    "Experiments.SingleCutCorridor.inserted_corridor_puncture": "Experiments.SingleCutCorridor.inserted_corridor_puncture : ∀ (e c : ℕ) (u : Finset ℕ),\n  u.Nonempty →\n    Experiments.SingleCutSpan.charge ((Experiments.SingleCutSpan.serial e (c + 1) u).erase (e + 1)) =\n      Experiments.SingleCutSpan.charge (Experiments.SingleCutSpan.serial e c u) + 1",
    "Experiments.SingleCutCorridor.zero_slack_accepts_both": "Experiments.SingleCutCorridor.zero_slack_accepts_both : ∀ (c : ℕ),\n  Experiments.SingleCutSpan.charge (Experiments.SingleCutSpan.serial 0 c {0}) ≤ 1 ∧\n    Experiments.SingleCutSpan.charge (Experiments.SingleCutSpan.serial 1 c {0}) ≤ 1",
    "Experiments.SingleCutCorridor.full_target_has_no_slack": "Experiments.SingleCutCorridor.full_target_has_no_slack : ∀ (e c q : ℕ),\n  Experiments.SingleCutSpan.charge (Experiments.SingleCutSpan.serial e c (Finset.range (q + 1))) = e",
    "Experiments.SingleCutCorridor.slack_cannot_decode_orientation": "Experiments.SingleCutCorridor.slack_cannot_decode_orientation : ¬∃ decode, decode 0 = Bool.false ∧ decode 0 = Bool.true",
    "Experiments.SingleCutCorridor.orientation_is_load_bearing": "Experiments.SingleCutCorridor.orientation_is_load_bearing : ∀ (c : ℕ),\n  Experiments.SingleCutSpan.charge (Experiments.SingleCutSpan.serial 0 c {0}) ≠\n    Experiments.SingleCutSpan.charge (Experiments.SingleCutSpan.serial 1 c {0})",
    "Experiments.SingleCutCorridor.puncture_changes_feasibility": "Experiments.SingleCutCorridor.puncture_changes_feasibility : Experiments.SingleCutSpan.charge\n      (Experiments.SingleCutSpan.serial 1 0 {0}) ≤\n    1 ∧\n  ¬Experiments.SingleCutSpan.charge ((Experiments.SingleCutSpan.serial 1 1 {0}).erase 2) ≤ 1",
    "Experiments.SingleCutCorridor.separate_occurrence_budgets": "@Experiments.SingleCutCorridor.separate_occurrence_budgets : ∀ {I : Type u_1} (e s : I → ℕ),\n  (∀ (i : I), e i + s i ≤ 1) → ∀ (i : I), e i + s i + (1 - e i - s i) = 1"
