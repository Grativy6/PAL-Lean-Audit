    "Experiments.CompactificationFixtures.mean_fiber": "Experiments.CompactificationFixtures.mean_fiber : ∀ (x y : Fin 6 → ℝ),\n  Experiments.CompactificationFixtures.mean x = Experiments.CompactificationFixtures.mean y ↔\n    x - y ∈ Experiments.CompactificationFixtures.mean.ker",
    "Experiments.CompactificationFixtures.mean_loses_comparisons": "Experiments.CompactificationFixtures.mean_loses_comparisons : ∃ x,\n  Experiments.CompactificationFixtures.mean x = Experiments.CompactificationFixtures.mean 0 ∧\n    Experiments.CompactificationFixtures.residual x ≠ Experiments.CompactificationFixtures.residual 0",
    "Experiments.CompactificationFixtures.sectorInteger": "Experiments.CompactificationFixtures.sectorInteger : ℝ → ℤ",
    "Experiments.CompactificationFixtures.sector": "Experiments.CompactificationFixtures.sector : ℝ → ℤ",
    "Experiments.CompactificationFixtures.angularResidual": "Experiments.CompactificationFixtures.angularResidual : ℝ → ℝ",
    "Experiments.CompactificationFixtures.residual_bounds": "Experiments.CompactificationFixtures.residual_bounds : ∀ (x : ℝ),\n  -1 / 12 ≤ Experiments.CompactificationFixtures.angularResidual x ∧\n    Experiments.CompactificationFixtures.angularResidual x < 1 / 12",
    "Experiments.CompactificationFixtures.sector_range": "Experiments.CompactificationFixtures.sector_range : ∀ (x : ℝ),\n  0 ≤ Experiments.CompactificationFixtures.sector x ∧ Experiments.CompactificationFixtures.sector x < 6",
    "Experiments.CompactificationFixtures.phase_reconstruction": "Experiments.CompactificationFixtures.phase_reconstruction : ∀ (x : ℝ),\n  x =\n    ↑(Experiments.CompactificationFixtures.sector x) / 6 + Experiments.CompactificationFixtures.angularResidual x +\n      ↑(Experiments.CompactificationFixtures.sectorInteger x / 6)",
    "Experiments.CompactificationFixtures.radians_reconstruction": "Experiments.CompactificationFixtures.radians_reconstruction : ∀ (theta : ℝ),\n  ∃ n,\n    theta =\n      ↑(Experiments.CompactificationFixtures.sector (theta / (2 * Real.pi))) * Real.pi / 3 +\n          2 * Real.pi * Experiments.CompactificationFixtures.angularResidual (theta / (2 * Real.pi)) +\n        2 * Real.pi * ↑n",
    "Experiments.CompactificationFixtures.sector_collision_and_tie": "Experiments.CompactificationFixtures.sector_collision_and_tie : Experiments.CompactificationFixtures.sector 0 =\n    Experiments.CompactificationFixtures.sector (1 / 24) ∧\n  0 ≠ 1 / 24 ∧\n    Experiments.CompactificationFixtures.sector (1 / 12) = 1 ∧\n      Experiments.CompactificationFixtures.angularResidual (1 / 12) = -1 / 12"
