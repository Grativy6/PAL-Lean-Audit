    "Experiments.SingleCutSpan.one_defect_criterion": "Experiments.SingleCutSpan.one_defect_criterion : ∀ (s : Finset ℕ),\n  Experiments.SingleCutSpan.charge s ≤ 1 ↔\n    Experiments.SingleCutSpan.hull s \\ s = ∅ ∨ ∃ x, Experiments.SingleCutSpan.hull s \\ s = {x}",
    "Experiments.SingleCutSpan.rankedSupport": "@Experiments.SingleCutSpan.rankedSupport : {V : Type u_1} → [DecidableEq V] → {n : ℕ} → V ≃ Fin n → Finset V → Finset ℕ",
    "Experiments.SingleCutSpan.bijective_order_preserves_support_size": "@Experiments.SingleCutSpan.bijective_order_preserves_support_size : ∀ {V : Type u_1} [inst : DecidableEq V] {n : ℕ}\n  (order : V ≃ Fin n) (s : Finset V), (Experiments.SingleCutSpan.rankedSupport order s).card = s.card",
    "Experiments.SingleCutSpan.hull_positions_realized": "@Experiments.SingleCutSpan.hull_positions_realized : ∀ {V : Type u_1} [inst : DecidableEq V] {n : ℕ} (order : V ≃ Fin n)\n  (s : Finset V),\n  ∀ x ∈ Experiments.SingleCutSpan.hull (Experiments.SingleCutSpan.rankedSupport order s), ∃ v, ↑(order v) = x",
