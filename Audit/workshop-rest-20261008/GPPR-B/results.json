    "Experiments.GPPREncoding.vogel_code_injective": "Experiments.GPPREncoding.vogel_code_injective : ∀ (z : ℂ),\n  Transcendental ℚ z →\n    Function.Injective (Experiments.GPPREncoding.code (fun j => ↑j) Experiments.GPPREncoding.vogelWeight z)",
    "Experiments.GPPREncoding.repeated_address_collision": "Experiments.GPPREncoding.repeated_address_collision : ((Experiments.GPPREncoding.weightedPoly (fun x => 1) (fun x => 1)\n      fun₀ | Bool.false => 1) =\n    Experiments.GPPREncoding.weightedPoly (fun x => 1) (fun x => 1) fun₀ | Bool.true => 1) ∧\n  (fun₀ | Bool.false => 1) ≠ fun₀ | Bool.true => 1",
