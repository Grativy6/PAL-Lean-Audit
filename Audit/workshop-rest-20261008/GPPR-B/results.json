    "Experiments.GPPREncoding.integer_code_injective": "Experiments.GPPREncoding.integer_code_injective : ∀ (address : Nat.Primes ↪ ℕ) (z : ℂ),\n  Transcendental ℚ z →\n    Set.InjOn (fun n => Experiments.GPPREncoding.code (⇑address) (fun x => 1) z (Experiments.GPPREncoding.valuation n))\n      {n | n ≠ 0}",
    "Experiments.GPPREncoding.integer_product_to_sum": "Experiments.GPPREncoding.integer_product_to_sum : ∀ (address : Nat.Primes → ℕ) (z : ℂ) {m n : ℕ},\n  m ≠ 0 →\n    n ≠ 0 →\n      Experiments.GPPREncoding.code address (fun x => 1) z (Experiments.GPPREncoding.valuation (m * n)) =\n        Experiments.GPPREncoding.code address (fun x => 1) z (Experiments.GPPREncoding.valuation m) +\n          Experiments.GPPREncoding.code address (fun x => 1) z (Experiments.GPPREncoding.valuation n)",
    "Experiments.GPPREncoding.rational_valuation_equality": "@Experiments.GPPREncoding.rational_valuation_equality : ∀ {a b c d : ℕ},\n  a ≠ 0 →\n    b ≠ 0 →\n      c ≠ 0 →\n        d ≠ 0 →\n          (Experiments.GPPREncoding.valuation a - Experiments.GPPREncoding.valuation b =\n              Experiments.GPPREncoding.valuation c - Experiments.GPPREncoding.valuation d ↔\n            ↑a / ↑b = ↑c / ↑d)",
    "Experiments.GPPREncoding.positive_rational_representation": "Experiments.GPPREncoding.positive_rational_representation : ∀ (q : ℚ), 0 < q → ∃ a b, a ≠ 0 ∧ b ≠ 0 ∧ q = ↑a / ↑b",
    "Experiments.GPPREncoding.rational_code_descends_and_separates": "Experiments.GPPREncoding.rational_code_descends_and_separates : ∀ (address : Nat.Primes ↪ ℕ) (z : ℂ),\n  Transcendental ℚ z →\n    ∀ {a b c d : ℕ},\n      a ≠ 0 →\n        b ≠ 0 →\n          c ≠ 0 →\n            d ≠ 0 →\n              (Experiments.GPPREncoding.code (⇑address) (fun x => 1) z\n                    (Experiments.GPPREncoding.valuation a - Experiments.GPPREncoding.valuation b) =\n                  Experiments.GPPREncoding.code (⇑address) (fun x => 1) z\n                    (Experiments.GPPREncoding.valuation c - Experiments.GPPREncoding.valuation d) ↔\n                ↑a / ↑b = ↑c / ↑d)",
    "Experiments.GPPREncoding.rational_product_valuations": "@Experiments.GPPREncoding.rational_product_valuations : ∀ {a b c d : ℕ},\n  a ≠ 0 →\n    b ≠ 0 →\n      c ≠ 0 →\n        d ≠ 0 →\n          Experiments.GPPREncoding.valuation (a * c) - Experiments.GPPREncoding.valuation (b * d) =\n            Experiments.GPPREncoding.valuation a - Experiments.GPPREncoding.valuation b +\n              (Experiments.GPPREncoding.valuation c - Experiments.GPPREncoding.valuation d)",
