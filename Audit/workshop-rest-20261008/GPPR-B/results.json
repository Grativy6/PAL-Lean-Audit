  "signatures": {
    "Experiments.GPPREncoding.weightedPoly": "@Experiments.GPPREncoding.weightedPoly : {I : Type u_1} →\n  {K : Type u_2} → [inst : CommRing K] → (I → ℕ) → (I → K) → (I →₀ ℤ) → Polynomial K",
    "Experiments.GPPREncoding.weighted_coeff": "@Experiments.GPPREncoding.weighted_coeff : ∀ {I : Type u_1} {K : Type u_2} [inst : CommRing K] (address : I ↪ ℕ)\n  (weight : I → K) (v : I →₀ ℤ) (i : I),\n  (Experiments.GPPREncoding.weightedPoly (⇑address) weight v).coeff (address i) = ↑(v i) * weight i",
    "Experiments.GPPREncoding.weighted_add": "@Experiments.GPPREncoding.weighted_add : ∀ {I : Type u_1} {K : Type u_2} [inst : CommRing K] (address : I → ℕ)\n  (weight : I → K) (v w : I →₀ ℤ),\n  Experiments.GPPREncoding.weightedPoly address weight (v + w) =\n    Experiments.GPPREncoding.weightedPoly address weight v + Experiments.GPPREncoding.weightedPoly address weight w",
    "Experiments.GPPREncoding.weighted_injective": "@Experiments.GPPREncoding.weighted_injective : ∀ {I : Type u_1} {K : Type u_2} [inst : CommRing K] [IsDomain K]\n  [CharZero K] (address : I ↪ ℕ) (weight : I → K),\n  (∀ (i : I), weight i ≠ 0) → Function.Injective (Experiments.GPPREncoding.weightedPoly (⇑address) weight)",
    "Experiments.GPPREncoding.code": "@Experiments.GPPREncoding.code : {I : Type u_1} →\n  {K : Type u_2} → [inst : CommRing K] → [Algebra K ℂ] → (I → ℕ) → (I → K) → ℂ → (I →₀ ℤ) → ℂ",
    "Experiments.GPPREncoding.exact_code_injective": "@Experiments.GPPREncoding.exact_code_injective : ∀ {I : Type u_1} {K : Type u_2} [inst : CommRing K] [IsDomain K]\n  [CharZero K] [inst_3 : Algebra K ℂ] (address : I ↪ ℕ) (weight : I → K),\n  (∀ (i : I), weight i ≠ 0) →\n    ∀ (z : ℂ), Transcendental K z → Function.Injective (Experiments.GPPREncoding.code (⇑address) weight z)",
    "Experiments.GPPREncoding.algebraic_weight_code_injective": "@Experiments.GPPREncoding.algebraic_weight_code_injective : ∀ {I : Type u_1} {K : Type u_2} [inst : CommRing K]\n  [IsDomain K] [CharZero K] [inst_3 : Algebra ℚ K] [inst_4 : Algebra K ℂ] [IsScalarTower ℚ K ℂ]\n  [Algebra.IsAlgebraic ℚ K] (address : I ↪ ℕ) (weight : I → K),\n  (∀ (i : I), weight i ≠ 0) →\n    ∀ (z : ℂ), Transcendental ℚ z → Function.Injective (Experiments.GPPREncoding.code (⇑address) weight z)",
    "Experiments.GPPREncoding.code_add": "@Experiments.GPPREncoding.code_add : ∀ {I : Type u_1} {K : Type u_2} [inst : CommRing K] [inst_1 : Algebra K ℂ]\n  (address : I → ℕ) (weight : I → K) (z : ℂ) (v w : I →₀ ℤ),\n  Experiments.GPPREncoding.code address weight z (v + w) =\n    Experiments.GPPREncoding.code address weight z v + Experiments.GPPREncoding.code address weight z w",
    "Experiments.GPPREncoding.code_single": "@Experiments.GPPREncoding.code_single : ∀ {I : Type u_1} {K : Type u_2} [inst : CommRing K] [inst_1 : Algebra K ℂ]\n  (address : I → ℕ) (weight : I → K) (z : ℂ) (i : I) (e : ℤ),\n  (Experiments.GPPREncoding.code address weight z fun₀ | i => e) =\n    ↑e * (Algebra.algebraMap K ℂ) (weight i) * z ^ address i",
