    "Experiments.GPPREncoding.valuation_mul": "@Experiments.GPPREncoding.valuation_mul : ∀ {m n : ℕ},\n  m ≠ 0 →\n    n ≠ 0 →\n      Experiments.GPPREncoding.valuation (m * n) =\n        Experiments.GPPREncoding.valuation m + Experiments.GPPREncoding.valuation n",
