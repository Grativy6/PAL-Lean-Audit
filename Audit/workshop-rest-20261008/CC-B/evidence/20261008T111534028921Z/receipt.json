  "signatures": {
    "Experiments.CompactificationProfile.Lost": "@Experiments.CompactificationProfile.Lost : {W : Type u_1} →\n  {T : Type u_2} → {Q : Type u_3} → (W → T) → (W → Q) → Set (W × W)",
    "Experiments.CompactificationProfile.refinement_exact": "@Experiments.CompactificationProfile.refinement_exact : ∀ {W : Type u_1} {T : Type u_2} {S : Type u_3} {Q : Type u_4}\n  (t : W → T) (s : W → S) (q : W → Q),\n  Experiments.CompactificationProfile.Lost (fun w => (t w, s w)) q =\n    Experiments.CompactificationProfile.Lost t q ∩ {p | s p.1 = s p.2}",
    "Experiments.CompactificationProfile.derived_side_changes_no_loss": "@Experiments.CompactificationProfile.derived_side_changes_no_loss : ∀ {W : Type u_1} {T : Type u_2} {S : Type u_3}\n  {Q : Type u_4} (t : W → T) (s : T → S) (q : W → Q),\n  Experiments.CompactificationProfile.Lost (fun w => (t w, s (t w))) q = Experiments.CompactificationProfile.Lost t q",
    "Experiments.CompactificationProfile.postprocessing_inclusion": "@Experiments.CompactificationProfile.postprocessing_inclusion : ∀ {W : Type u_1} {T : Type u_2} {S : Type u_3}\n  {Q : Type u_4} (t : W → T) (p : T → S) (q : W → Q),\n  Experiments.CompactificationProfile.Lost t q ⊆ Experiments.CompactificationProfile.Lost (p ∘ t) q",
    "Experiments.CompactificationProfile.postprocessing_equality": "@Experiments.CompactificationProfile.postprocessing_equality : ∀ {W : Type u_1} {T : Type u_2} {S : Type u_3}\n  {Q : Type u_4} (t : W → T) (p : T → S) (q : W → Q),\n  Set.InjOn p (Set.range t) →\n    Experiments.CompactificationProfile.Lost (p ∘ t) q = Experiments.CompactificationProfile.Lost t q",
    "Experiments.CompactificationProfile.question_coarsening": "@Experiments.CompactificationProfile.question_coarsening : ∀ {W : Type u_1} {T : Type u_2} {Q : Type u_3}\n  {Q' : Type u_4} (t : W → T) (q : W → Q) (h : Q → Q'),\n  Experiments.CompactificationProfile.Lost t (h ∘ q) ⊆ Experiments.CompactificationProfile.Lost t q",
    "Experiments.CompactificationProfile.question_injective_equality": "@Experiments.CompactificationProfile.question_injective_equality : ∀ {W : Type u_1} {T : Type u_2} {Q : Type u_3}\n  {Q' : Type u_4} (t : W → T) (q : W → Q) (h : Q → Q'),\n  Set.InjOn h (Set.range q) →\n    Experiments.CompactificationProfile.Lost t (h ∘ q) = Experiments.CompactificationProfile.Lost t q",
    "Experiments.CompactificationProfile.strict_loss_controls": "Experiments.CompactificationProfile.strict_loss_controls : Experiments.CompactificationProfile.Lost id id = ∅ ∧\n  (Bool.false, Bool.true) ∈ Experiments.CompactificationProfile.Lost (fun x => ()) id ∧\n    (Experiments.CompactificationProfile.Lost (fun x => ()) fun x => ()) = ∅",
    "Experiments.CompactificationProfile.Extension": "@Experiments.CompactificationProfile.Extension : {A : Type u_1} → {S : Type u_2} → (A → S) → (A → Prop) → S → Type u_1",
    "Experiments.CompactificationProfile.quotient_descent_iff": "@Experiments.CompactificationProfile.quotient_descent_iff : ∀ {A : Type u_1} {D : Type u_2} (r : Setoid A) (f : A → D),\n  (∀ (a b : A), r a b → f a = f b) ↔ ∃! d, ∀ (a : A), d ⟦a⟧ = f a",
    "Experiments.CompactificationProfile.extensionEquiv": "@Experiments.CompactificationProfile.extensionEquiv : {A : Type u_1} →\n  {B : Type u_2} →\n    {S : Type u_3} →\n      (e : A ≃ B) →\n        (rA : A → S) →\n          (rB : B → S) →\n            (aA : A → Prop) →\n              (aB : B → Prop) →\n                (base : S) →\n                  (∀ (a : A), aB (e a) ↔ aA a) →\n                    (∀ (a : A), rB (e a) = rA a) →\n                      Experiments.CompactificationProfile.Extension rA aA base ≃\n                        Experiments.CompactificationProfile.Extension rB aB base",
    "Experiments.CompactificationProfile.extension_existence_preserved": "@Experiments.CompactificationProfile.extension_existence_preserved : ∀ {A : Type u_1} {B : Type u_2} (e : A ≃ B),\n  Nonempty A ↔ Nonempty B",
    "Experiments.CompactificationProfile.detector_image_transport": "@Experiments.CompactificationProfile.detector_image_transport : ∀ {A : Type u_1} {B : Type u_2} {D : Type u_3}\n  (e : A ≃ B) (dA : A → D) (dB : B → D), (∀ (a : A), dB (e a) = dA a) → Set.range dA = Set.range dB",
    "Experiments.CompactificationProfile.loss_transport": "@Experiments.CompactificationProfile.loss_transport : ∀ {A : Type u_1} {B : Type u_2} {T : Type u_3} {Q : Type u_4}\n  (e : A ≃ B) (tA : A → T) (tB : B → T) (qA : A → Q) (qB : B → Q),\n  (∀ (a : A), tB (e a) = tA a) →\n    (∀ (a : A), qB (e a) = qA a) →\n      Experiments.CompactificationProfile.Lost tA qA =\n        (fun p => (e p.1, e p.2)) ⁻¹' Experiments.CompactificationProfile.Lost tB qB",
    "Experiments.CompactificationProfile.empty_extensions_vacuous_decoder": "Experiments.CompactificationProfile.empty_extensions_vacuous_decoder : (∀ (a b : Empty),\n    (fun x => ()) a = (fun x => ()) b → a = b) ∧\n  ¬Nonempty Empty",
    "Experiments.CompactificationProfile.undefined_is_not_zero": "Experiments.CompactificationProfile.undefined_is_not_zero : Option.none ≠ Option.some 0",
    "Experiments.CompactificationProfile.empty_reachable_decoder": "Experiments.CompactificationProfile.empty_reachable_decoder : ∃ d, ∀ (a : Empty), d ⟨(), ⋯⟩ = Bool.false",
    "Experiments.CompactificationProfile.compatible_restriction_telescope": "@Experiments.CompactificationProfile.compatible_restriction_telescope : ∀ {A : Type u_1} {B : Type u_2} {C : Type u_3}\n  {G : Type u_4} [inst : AddCommGroup G] (rAB : A → B) (rBC : B → C) (iA : A → G) (iB : B → G) (iC : C → G) (a : A),\n  iA a - iC (rBC (rAB a)) = iA a - iB (rAB a) + (iB (rAB a) - iC (rBC (rAB a)))",
