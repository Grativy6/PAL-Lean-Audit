
/-!
# PAL v2.3 A13 cadence and productive-step audit

This module checks finite transition algebra. Administrative steps preserve a
supplied projection; productive steps lower a supplied Nat rank. No scheduler,
fairness, infinite recurrence, or PAL adoption is modeled.
-/

namespace Experiments.Pal23Cadence

universe uS uP
variable {S : Type uS} {P : Type uP}

/-- Reflexive transitive closure generated by administrative steps. -/
inductive AdminClosure (admin : S → S → Prop) : S → S → Prop where
  | refl (x : S) : AdminClosure admin x x
  | step {x y z : S} : admin x y → AdminClosure admin y z → AdminClosure admin x z

/-- One macrostep consists of finitely many admin steps, one productive step, then admin steps. -/
def Macrostep (admin productive : S → S → Prop) (x y : S) : Prop :=
  ∃ a b, AdminClosure admin x a ∧ productive a b ∧ AdminClosure admin b y

/-- Any supplied projection is preserved along an administrative closure. -/
theorem admin_closure_preserves_projection (admin : S → S → Prop) (project : S → P)
    (hadmin : ∀ x y, admin x y → project x = project y) :
    ∀ {x y}, AdminClosure admin x y → project x = project y := by
  intro x y h
  induction h with
  | refl => rfl
  | step hxy _ ih => exact (hadmin _ _ hxy).trans ih

/-- A macrostep preserves the work projection when its productive step does too. -/
theorem macrostep_preserves_work_projection (admin productive : S → S → Prop)
    (work : S → P)
    (hadmin : ∀ x y, admin x y → work x = work y)
    (hproductive : ∀ x y, productive x y → work x = work y) :
    ∀ {x y}, Macrostep admin productive x y → work x = work y := by
  intro x y h
  rcases h with ⟨a, b, hxa, hab, hby⟩
  have h1 := admin_closure_preserves_projection admin work hadmin hxa
  have h2 := hproductive _ _ hab
  have h3 := admin_closure_preserves_projection admin work hadmin hby
  exact h1.trans (h2.trans h3)

/-- A productive change in a supplied progress coordinate survives admin stuttering. -/
theorem macrostep_changes_progress_coordinate (admin productive : S → S → Prop)
    (progress : S → P)
    (hadmin : ∀ x y, admin x y → progress x = progress y)
    (hproductive : ∀ x y, productive x y → progress x ≠ progress y)
    {x y : S} (hstep : Macrostep admin productive x y) : progress x ≠ progress y := by
  rcases hstep with ⟨a, b, hxa, hab, hby⟩
  have h1 := admin_closure_preserves_projection admin progress hadmin hxa
  have h2 := admin_closure_preserves_projection admin progress hadmin hby
  intro heq
  apply hproductive _ _ hab
  calc
    progress a = progress x := h1.symm
    _ = progress y := heq
    _ = progress b := h2.symm

/-- Rank is unchanged across a macrostep's admin segments and lowered by its productive step. -/
theorem macrostep_strict_rank_descent (admin productive : S → S → Prop)
    (rank : S → Nat)
    (hadmin : ∀ x y, admin x y → rank x = rank y)
    (hproductive : ∀ x y, productive x y → rank y < rank x) :
    ∀ {x y}, Macrostep admin productive x y → rank y < rank x := by
  intro x y h
  rcases h with ⟨a, b, hxa, hab, hby⟩
  have h1 := admin_closure_preserves_projection admin rank hadmin hxa
  have h2 := admin_closure_preserves_projection admin rank hadmin hby
  rw [← h2, h1]
  exact hproductive _ _ hab

/-- A finite sequence of macrosteps, indexed by its exact number of productive steps. -/
inductive MacroRun (macrostep : S → S → Prop) : Nat → S → S → Prop where
  | nil (x : S) : MacroRun macrostep 0 x x
  | cons {n : Nat} {x y z : S} :
      macrostep x y → MacroRun macrostep n y z → MacroRun macrostep (n + 1) x z

/-- Strict Nat-rank descent bounds every finite macrostep count by the initial rank. -/
theorem macro_run_length_le_initial_rank (macrostep : S → S → Prop)
    (rank : S → Nat) (hdesc : ∀ x y, macrostep x y → rank y < rank x) :
    ∀ {n x y}, MacroRun macrostep n x y → n ≤ rank x := by
  intro n x y hrun
  induction hrun with
  | nil => exact Nat.zero_le _
  | cons hxy _ ih =>
      have hlt := hdesc _ _ hxy
      exact Nat.succ_le_of_lt (Nat.lt_of_le_of_lt ih hlt)

/-- Projection preservation does not imply rank preservation for administrative steps. -/
theorem admin_projection_need_not_preserve_rank :
    ∃ x y : Nat × Nat,
      x.1 = y.1 ∧ x.2 ≠ y.2 ∧
        (x.1 = y.1 ∧ y.2 = x.2 + 1) := by
  exact ⟨(0, 0), (0, 1), rfl, by decide, ⟨rfl, rfl⟩⟩

/-- Any finite number of identity-administration steps can recur without a productive macrostep. -/
theorem admin_recurrence_does_not_force_productive_step (x : S) (n : Nat) :
    AdminClosure (fun a b : S => a = b) x x ∧
      MacroRun (fun a b : S => a = b) n x x ∧
      ¬ ∃ y, Macrostep (fun a b : S => a = b) (fun _ _ : S => False) x y := by
  refine ⟨AdminClosure.refl x, ?_, ?_⟩
  · induction n with
    | zero => exact MacroRun.nil x
    | succ n ih => exact MacroRun.cons rfl ih
  · rintro ⟨y, a, b, _, hproductive, _⟩
    exact hproductive

/-- Two intervening work changes can return to the same observed endpoint. -/
theorem endpoint_equality_can_hide_two_work_changes :
    ∃ x middle finish : Bool,
      x ≠ middle ∧ middle ≠ finish ∧ x = finish := by
  exact ⟨false, true, false, by decide, by decide, rfl⟩

/-- Administrative rank replenishment can cancel a productive descent in one macrostep. -/
theorem admin_rank_replenishment_cancels_net_descent :
    let admin : Nat → Nat → Prop := fun x y => y = x + 1
    let productive : Nat → Nat → Prop := fun x y => x = y + 1
    (∀ x y, admin x y → (fun _ : Nat => ()) x = (fun _ : Nat => ()) y) ∧
      (∀ x y, productive x y → y < x) ∧
      Macrostep admin productive 0 0 ∧ ¬ (0 < 0) := by
  dsimp
  refine ⟨?_, ?_, ?_, Nat.not_lt_zero _⟩
  · intro x y _
    rfl
  · intro x y h
    rw [h]
    exact Nat.lt_succ_self y
  · refine ⟨1, 0, ?_, rfl, AdminClosure.refl 0⟩
    exact AdminClosure.step rfl (AdminClosure.refl 1)

/-- Generic typecheck fixture for the arbitrary progress codomain. -/
example (admin productive : S → S → Prop) (progress : S → P)
    (hadmin : ∀ x y, admin x y → progress x = progress y)
    (hproductive : ∀ x y, productive x y → progress x ≠ progress y)
    {x y : S} (hstep : Macrostep admin productive x y) : progress x ≠ progress y :=
  macrostep_changes_progress_coordinate admin productive progress hadmin hproductive hstep

end Experiments.Pal23Cadence
